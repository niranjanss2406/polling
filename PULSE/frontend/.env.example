# Frontend Environment Configuration
# For local dev / LAN / tunnels: leave empty (Vite dev proxy forwards /api and /ws automatically)
VITE_API_URL=
VITE_WS_URL=

# When deploying frontend on Vercel / Netlify / Render:
# Set this to your live backend domain:
# VITE_API_URL=https://your-backend.onrender.com
# VITE_WS_URL=wss://your-backend.onrender.com
